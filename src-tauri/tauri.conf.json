{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "claude-lineup",
  "version": "0.1.0",
  "identifier": "app.claudelineup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://localhost:5180",
    "beforeBuildCommand": "npm run build:ui",
    "frontendDist": "../dist/ui"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "claude-lineup", "width": 1280, "height": 800 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
